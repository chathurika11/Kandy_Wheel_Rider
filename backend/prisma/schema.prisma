generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

enum VehicleStatus {
  AVAILABLE
  MAINTENANCE
  INACTIVE
}

enum BookingStatus {
  PENDING
  CONFIRMED
  REJECTED
  CANCELLED
}

enum ServiceListingCategory {
  CAMPING_GADGET
  TOUR_GUIDE
}

enum ServiceListingStatus {
  AVAILABLE
  UNAVAILABLE
}

model AdminUser {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model AdminAuditLog {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  adminId    String   @db.ObjectId
  adminEmail String
  action     String
  details    String?
  createdAt  DateTime @default(now())
}

model RentalSettings {
  id              String   @id @default(auto()) @map("_id") @db.ObjectId
  key             String   @unique @default("default")
  extraHourlyRate Float    @default(0)
  updatedAt       DateTime @updatedAt
}

model Vehicle {
  id           String        @id @default(auto()) @map("_id") @db.ObjectId
  name         String
  brand        String
  model        String
  year         Int
  type         String
  description  String
  dailyRate    Float
  engineCc     Int
  transmission String
  seats        Int
  location     String
  status       VehicleStatus @default(AVAILABLE)
  features     String[]
  images       VehicleImage[]
  bookings     Booking[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
}

model VehicleImage {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  vehicleId String   @db.ObjectId
  vehicle   Vehicle  @relation(fields: [vehicleId], references: [id])
  url       String
  alt       String
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
}

model ServiceListing {
  id          String                  @id @default(auto()) @map("_id") @db.ObjectId
  category    ServiceListingCategory
  name        String
  description String
  price       Float
  priceUnit   String                  @default("day")
  details     String[]
  status      ServiceListingStatus    @default(AVAILABLE)
  images      ServiceListingImage[]
  createdAt   DateTime                @default(now())
  updatedAt   DateTime                @updatedAt
}

model ServiceListingImage {
  id        String         @id @default(auto()) @map("_id") @db.ObjectId
  listingId String         @db.ObjectId
  listing   ServiceListing @relation(fields: [listingId], references: [id])
  url       String
  alt       String
  sortOrder Int            @default(0)
  createdAt DateTime       @default(now())
}

model Booking {
  id             String        @id @default(auto()) @map("_id") @db.ObjectId
  vehicleId      String        @db.ObjectId
  vehicle        Vehicle       @relation(fields: [vehicleId], references: [id])
  customerName   String
  contactNumber  String
  email          String
  nicOrPassport  String?
  pickupDate     DateTime
  returnDate     DateTime
  pickupLocation String
  notes          String?
  whatsappConsentAt DateTime?
  fullRentalDays Int?
  extraHours     Int?
  extraHourlyRate Float?
  totalAmount    Float
  paymentSlipUrl String
  status         BookingStatus @default(PENDING)
  adminNotes     String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
}
